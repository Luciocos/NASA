// lotestigo en cloudflare workers: worker/index.js publica el build de angular y reenvía /api y /media al backend
{
  "name": "lotestigo",
  "main": "worker/index.js",
  // la más nueva que soporta wrangler 4.155.0: con una posterior, wrangler dev no arranca
  "compatibility_date": "2026-10-30",
  // la app queda pública en https://lotestigo.<subdominio>.workers.dev, sin login y sin links extra por versión
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    // lo genera ng build (npm run build desde la raíz)
    "directory": "./frontend/dist/frontend/browser",
    "binding": "ASSETS",
    // el worker atiende todo: decide qué va al backend y responde index.html en las rutas de angular
    "run_worker_first": true
  },
  "vars": {
    // el backend: django y postgres en railway (proyecto lotestigo, servicio backend)
    "API_ORIGIN": "https://backend-production-4b7a9dfd.up.railway.app"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
