# Copiar a .env y completar. El archivo .env no se sube al repositorio.

# Base de datos (docker compose y Django)
POSTGRES_DB=lotestigo
POSTGRES_USER=lotestigo
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Earthdata Login (solo para pipeline/, nunca en el backend)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Precio sugerido de mercado (Matba Rofex vía pyRofex, solo en el backend)
# ROFEX_ENVIRONMENT: LIVE (mercado real, cuenta de un agente) o REMARKET (prueba, precios simulados)
ROFEX_USER=
ROFEX_PASSWORD=
ROFEX_ACCOUNT=
ROFEX_ENVIRONMENT=
